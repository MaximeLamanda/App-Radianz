{
  "name": "app.radianz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next",
    "dev": "ulimit -n 10240 2>/dev/null || true; next dev -p 3000",
    "dev:clean": "npm run clean && npm run dev",
    "dev:3001": "ulimit -n 10240 2>/dev/null || true; next dev -p 3001",
    "dev:restart": "bash scripts/dev.sh",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "playwright:install": "playwright install chromium",
    "init-energy-data": "tsx scripts/init-energy-data.ts",
    "update-hourly-consumption": "tsx scripts/update-hourly-consumption-firebase.ts",
    "test:apicarto": "node scripts/test-apicarto-cadastre.mjs",
    "enrich:dep33": "node scripts/enrich-sitadel-dep33-apicarto.mjs",
    "enrich:by-commune": "node scripts/enrich-sitadel-by-commune.mjs",
    "enrich:by-department": "node scripts/enrich-sitadel-by-department.mjs",
    "build:bdnb-poi-sample": "tsx scripts/build-bdnb-poi-sample.ts",
    "build:bdnb-poi-sample:all": "BDNB_POI_SAMPLE_ALL=1 tsx scripts/build-bdnb-poi-sample.ts",
    "test:unit": "vitest run",
    "import:bdnb-dep33": "node scripts/import-bdnb-postgres.mjs --data-dir=bdnb/dep33_millesime_2025_07a/extract --all --departements=33",
    "bdnb:clean-tables": "node scripts/clean-bdnb-postgres.mjs",
    "bdnb:migrate-staging-columns": "node scripts/migrate-bdnb-staging-columns.mjs",
    "bdnb:poi-sample:schema": "node scripts/apply-scout-bdnb-poi-schema.mjs",
    "bdnb:poi-sample:import": "node scripts/import-bdnb-poi-geojson-to-postgres.mjs",
    "import:parcelles-pessac": "python3 data-pipeline/python/import_parcelles_personnes_morales.py --parquet datasource/parcelles-personnes-morales/parcelles-personnes-morales-latest.parquet --code-insee=33318 --apply-schema --truncate",
    "import:cadastre-33-parcelles:pessac": "python3 data-pipeline/python/import_cadastre_france_feuilles.py --geojson-gz datasource/cadastre/cadastre-33-parcelles.json.gz --code-insee=33318 --apply-schema --truncate",
    "bdnb:reimport": "npm run bdnb:clean-tables && npm run import:bdnb-dep33",
    "bdnb:delete-residentiel-individuel": "node scripts/delete-bdnb-residentiel-individuel.mjs",
    "bdnb:delete-residentiel-individuel:dry-run": "node scripts/delete-bdnb-residentiel-individuel.mjs --dry-run",
    "neon:dump-local": "bash scripts/neon-dump-local-docker.sh",
    "neon:transfer": "bash scripts/neon-transfer-local-docker-to-neon.sh",
    "neon:transfer:no-indexes": "NEON_TRANSFER_MODE=no-indexes bash scripts/neon-transfer-local-docker-to-neon.sh",
    "neon:transfer:indexes": "NEON_TRANSFER_MODE=indexes-only bash scripts/neon-transfer-local-docker-to-neon.sh",
    "neon:drop-discovery-artifacts:dry": "DRY_RUN=1 node scripts/neon-drop-discovery-artifact-tables.mjs",
    "neon:drop-discovery-artifacts": "node scripts/neon-drop-discovery-artifact-tables.mjs",
    "neon:drop-bdnb-after-v5-enrichment:dry": "DRY_RUN=1 node scripts/neon-drop-bdnb-after-v5-enrichment.mjs",
    "neon:drop-bdnb-after-v5-enrichment": "node scripts/neon-drop-bdnb-after-v5-enrichment.mjs",
    "neon:sync-v5-building-geometries:dry": "DRY_RUN=1 node scripts/sync-scout-v5-building-geometries-json.mjs",
    "neon:sync-v5-building-geometries": "node scripts/sync-scout-v5-building-geometries-json.mjs",
    "postgres:local:up": "PATH=\"/usr/local/bin:/opt/homebrew/bin:$PATH\" docker compose up -d",
    "postgres:local:down": "PATH=\"/usr/local/bin:/opt/homebrew/bin:$PATH\" docker compose down",
    "pipeline:matching-v5:run": "bash -lc 'set -a; [ -f .env.local ] && . ./.env.local; set +a; ./data-pipeline/python/.venv-v311/bin/python data-pipeline/matching_v5/run_matching_v5.py --min-parcelle-footprint-sum-m2 400'",
    "pipeline:matching-v5:run-google": "bash -lc 'set -a; [ -f .env.local ] && . ./.env.local; set +a; ./data-pipeline/python/.venv-v311/bin/python data-pipeline/matching_v5/run_matching_v5.py --min-parcelle-footprint-sum-m2 400 --google-fallback'",
    "pipeline:matching-v5:backfill-building-geometries": "bash -lc 'set -a; [ -f .env.local ] && . ./.env.local; set +a; ./data-pipeline/python/.venv-v311/bin/python data-pipeline/matching_v5/backfill_building_geometries_v5.py'",
    "pipeline:osm-poi:schema": "bash -lc 'set -a; [ -f .env.local ] && . ./.env.local; set +a; ./data-pipeline/python/.venv-v311/bin/python data-pipeline/matching_v5/import_osm_poi.py --ensure-schema'",
    "pipeline:osm-poi:import": "bash -lc 'set -a; [ -f .env.local ] && . ./.env.local; set +a; ./data-pipeline/python/.venv-v311/bin/python data-pipeline/matching_v5/import_osm_poi.py --input datasource/osm/aquitaine-260406.osm.pbf --truncate'",
    "import:bdnb-constructions:local": "node scripts/import-bdnb-constructions-local.mjs --data-dir=datasource/bdnb/dep33_extract"
  },
  "dependencies": {
    "@googlemaps/markerclusterer": "^2.6.2",
