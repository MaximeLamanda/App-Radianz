rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Base de données de consommation énergétique par type de bâtiment
    // Lecture : nécessaire pour les calculs solaires
    // Écriture : nécessaire pour l'init (admin/init-energy-data ou script)
    match /building_energy_consumption/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Pipeline prospects (Solar Scout)
    // Lecture : propriétaire, non réclamés (migration), ou document avec shareToken (lien public)
    // Écriture : propriétaire uniquement (ou claim si pas encore de userId)
    match /prospects/{prospectId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || !('userId' in resource.data))
        || resource.data.shareToken != null;
      allow create: if request.auth != null
        && (request.resource.data.userId == request.auth.uid || !('userId' in request.resource.data));
      allow update: if request.auth != null
        && (resource.data.userId == request.auth.uid || !('userId' in resource.data))
        && (request.resource.data.userId == request.auth.uid || request.resource.data.userId == resource.data.userId);
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Leads (boîte de réception)
    match /leads/{leadId} {
      allow read, write: if true;
    }

    // Références de panneaux solaires (par utilisateur)
    // Lecture publique pour la page prospect partagée (visiteur non connecté)
    match /users/{userId}/panel_references/{refId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Références d'onduleurs (par utilisateur)
    match /users/{userId}/inverter_references/{refId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Profil utilisateur (téléphone, prénom, nom) — lecture/écriture par le propriétaire
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Bloquer tout le reste par défaut
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
