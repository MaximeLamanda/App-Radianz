rules_version = '2';

// Firebase Storage : images des références de panneaux et onduleurs
// À publier dans la console Firebase : Storage → Règles
service firebase.storage {
  match /b/{bucket}/o {

    // Photos des références de panneaux (par utilisateur)
    match /users/{userId}/panel_references/{fileName} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Photos des références d'onduleurs (par utilisateur)
    match /users/{userId}/inverter_references/{fileName} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Logo entreprise (onboarding, profil)
    match /users/{userId}/{fileName} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Chemins legacy (panel_references, inverter_references) - rétrocompatibilité
    match /panel_references/{fileName} {
      allow read: if true;
      allow write: if true;
    }
    match /inverter_references/{fileName} {
      allow read: if true;
      allow write: if true;
    }

    // Photos de profil utilisateur : lecture publique (affichage), écriture par le propriétaire uniquement
    match /user_photos/{userId}/{fileName} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Bloquer tout le reste par défaut (optionnel : autoriser d'autres dossiers plus tard)
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
